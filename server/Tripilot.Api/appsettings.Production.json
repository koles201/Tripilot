{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Error"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-production-host;Port=5432;Database=tripilot_prod;Username=tripilot_user;Password=your-secure-password"
  },
  "DetailedErrors": false,
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_SECURE_KEY_FROM_ENVIRONMENT_VARIABLES",
    "Issuer": "TripilotAPI",
    "Audience": "TripilotClient",
    "ExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  }
}
